# Uso exclusivo do servidor. Nunca expor por DefinePlugin, VITE_* ou NEXT_PUBLIC_*.
# Production: cadastrar diretamente como Secret na Vercel.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternativa local SEM credenciais reais, com emuladores iniciados:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GCLOUD_PROJECT=demo-circuit-qscratch
# O front também precisa ser iniciado com FIREBASE_EMULATORS=true.
